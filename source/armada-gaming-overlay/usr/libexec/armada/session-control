#!/usr/bin/env bash
set -euo pipefail

SESSION="${1:-gamescope}"

case "$SESSION" in
  desktop|plasma)
    if [ -f /usr/libexec/armada/device-env ]; then
      eval "$(/usr/libexec/armada/device-env)"
    fi
    sed -i 's/^Session=.*/Session=plasma.desktop/' /etc/sddm.conf.d/autologin.conf 2>/dev/null || true
    systemctl restart sddm 2>/dev/null || true
    ;;
  gamescope)
    if [ -f /usr/libexec/armada/device-env ]; then
      eval "$(/usr/libexec/armada/device-env)"
    fi
    sed -i 's/^Session=.*/Session=steam.desktop/' /etc/sddm.conf.d/autologin.conf 2>/dev/null || true
    systemctl restart sddm 2>/dev/null || true
    ;;
  *)
    echo "unknown session: $SESSION" >&2
    exit 1
    ;;
esac
