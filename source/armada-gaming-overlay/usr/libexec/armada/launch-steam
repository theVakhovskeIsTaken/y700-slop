#!/usr/bin/env bash
set -euo pipefail

if [ -f /usr/libexec/armada/device-env ]; then
  eval "$(/usr/libexec/armada/device-env)"
fi

STEAM_DIR="${HOME}/.local/share/Steam"
STEAMRT_DIR="${STEAM_DIR}/steamrtarm64"
STEAM_BIN="${STEAMRT_DIR}/steam"

export LD_LIBRARY_PATH="${STEAMRT_DIR}:${STEAM_DIR}/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="${STEAMRT_DIR}/bin:${STEAM_DIR}/steam-runtime-steamrt-arm64/bin${PATH:+:$PATH}"
export FUSERMOUNT_PROG="/usr/bin/fusermount3"

mkdir -p "$STEAM_DIR/.cef-enable-remote-debugging" 2>/dev/null || touch "$STEAM_DIR/.cef-enable-remote-debugging"

if [ -n "${ARMADA_SOC_CLASS:-}" ]; then
  case "$ARMADA_SOC_CLASS" in
    SM8650)
      export DXVK_HUD="none"
      ;;
  esac
fi

exec "$STEAM_BIN" -steamdeck "$@"
